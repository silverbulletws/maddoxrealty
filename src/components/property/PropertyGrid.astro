---
// A grid of listing cards: three across, two on tablets, one on phones.
import PropertyCard from './PropertyCard.astro';

const { entries } = Astro.props;
---

{entries.length > 0 && (
  <ul class="grid auto-rows-fr grid-cols-1 gap-[30px] md:grid-cols-2 lg:grid-cols-3">
    {entries.map((entry) => <PropertyCard entry={entry} />)}
  </ul>
)}
